rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Contador total de visitantes (documento único `stats/visits`).
    // Regra permanente (sem data de validade):
    //  • leitura liberada — qualquer visitante pode ver o total;
    //  • escrita só permite documentos contendo EXCLUSIVAMENTE o campo
    //    numérico `count`, evitando que alguém grave lixo na coleção.
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['count'])
                            && request.resource.data.count is int;
    }

    // Coleção de presença usada pelo contador de visitantes ONLINE agora.
    //  • leitura liberada — qualquer visitante pode ver a contagem;
    //  • escrita só permite documentos contendo EXCLUSIVAMENTE `lastSeen`.
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen']);
      allow delete: if true;
    }

    // Tudo o que não for `stats`/`presence` fica negado por padrão (seguro).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

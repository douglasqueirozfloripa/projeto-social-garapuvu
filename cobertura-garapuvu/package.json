{
  "name": "cobertura-garapuvu",
  "version": "1.1.0",
  "private": true,
  "description": "Aula 09 — Projeto Social Garapuvu 2026: por que 100% de cobertura não é 100% de cobertura (e muito menos ausência de bugs).",
  "main": "src/01-tipos-inesperados.js",
  "scripts": {
    "test": "jest",
    "ilusao": "jest tests/ilusao",
    "realidade": "jest tests/realidade",
    "robustez": "jest tests/robustez",
    "cobertura": "jest tests/ilusao --coverage",
    "cobertura:corrigido": "jest tests/realidade tests/robustez --coverage --collectCoverageFrom=src/corrigido/*.js",
    "mutacao": "stryker run stryker.ilusao.conf.json",
    "mutacao:corrigido": "stryker run stryker.corrigido.conf.json",
    "mutacao:completa": "stryker run stryker.conf.json",
    "placar": "npm run cobertura && npm run cobertura:corrigido && npm run mutacao && npm run mutacao:corrigido"
  },
  "keywords": [
    "qa",
    "testes-unitarios",
    "cobertura",
    "teste-de-mutacao",
    "ctfl",
    "garapuvu"
  ],
  "author": "Douglas Adriano Queiroz — Projeto Social Garapuvu 2026",
  "license": "MIT",
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "jest": "^29.7.0"
  }
}

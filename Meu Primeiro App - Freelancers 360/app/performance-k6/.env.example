# Configuração de ambiente do subprojeto de performance (k6).
# Copie para ".env" e ajuste.
#
# O k6 não carrega arquivos .env automaticamente: exporte-o no shell antes de
# rodar (`set -a; source .env; set +a`) ou passe direto na linha de comando
# (`k6 run -e TEMA=joaquina load.js`).

# Tema de cores do relatório HTML. Opções: garapuvu | joaquina | oceano | uva
TEMA=garapuvu

# URL base da API sob teste (padrão: http://localhost:3001)
BASE_URL=http://localhost:3001

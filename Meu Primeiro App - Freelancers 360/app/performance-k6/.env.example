# Configuração de ambiente do subprojeto de performance (k6).
# Copie para ".env" e ajuste. Use com:  k6 run --env-file .env load.js
# (o --env-file exige k6 >= 0.47; alternativa sempre disponível: -e TEMA=joaquina)

# Tema de cores do relatório HTML. Opções: garapuvu | joaquina | oceano | uva
TEMA=garapuvu

# URL base da API sob teste (padrão: http://localhost:3001)
BASE_URL=http://localhost:3001

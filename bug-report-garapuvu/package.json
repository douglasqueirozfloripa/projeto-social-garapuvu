{
  "name": "bug-report-garapuvu",
  "version": "1.0.0",
  "description": "Plataforma de abertura e documentação de bugs — Aula B4 do curso Projeto Social Garapuvu",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api",
    "test:e2e": "playwright test",
    "test:coverage": "jest tests/unit tests/api --coverage",
    "test:demo": "playwright test --config=playwright.demo.config.js",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e",
    "fixtures:video": "node tests/fixtures/gerar-video-evidencia.js"
  },
  "keywords": ["qa", "bug-report", "garapuvu", "ctfl"],
  "author": "Projeto Social Garapuvu",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
